{
  "expo": {
    "name": "SafnexBD",
    "slug": "safnexbd",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safnexbd.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.safnexbd.app"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
