# SafnexBD Backend Production Environment Configuration
PORT=5000
DATABASE_URL="mysql://safnex_user:STRONG_PASSWORD_HERE@localhost:3306/safnexbd"

# JWT Authentication
JWT_SECRET="generate_a_very_strong_random_jwt_secret_key_here_at_least_64_chars"
JWT_REFRESH_SECRET="generate_a_very_strong_random_jwt_refresh_key_here_at_least_64_chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Domain & CORS
FRONTEND_URL="https://safnexbd.com"

# Uploads & Storage
UPLOAD_DIR="/var/www/safnexbd/uploads"
MAX_FILE_SIZE_MB=25

# Encryption Key (Must be exactly 32 bytes for AES-256)
ENCRYPTION_KEY="safnexbd_32_bytes_secret_key_prod!!"

